datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("user") // "admin" or "user"
  phone         String?
  address       String?
  city          String?
  zip           String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model EmailVerificationOtp {
  id                    String    @id @default(uuid())
  email                 String
  otpHash               String
  expiresAt             DateTime
  attempts              Int       @default(0)
  createdAt             DateTime  @default(now())
  consumedAt            DateTime?
  verificationTokenHash String?

  @@map("email_verification_otps")
}

model PasswordResetOtp {
  id                  String    @id @default(uuid())
  email               String
  otpHash             String
  expiresAt           DateTime
  attempts            Int       @default(0)
  createdAt           DateTime  @default(now())
  consumedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  @@map("password_reset_otps")
}

model Order {
  id        String      @id
  name      String
  email     String
  address   String
  city      String
  zip       String
  phone     String
  total     Float
  status    String      @default("Processing")
  method    String      @default("cod")
  date      String
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  qty         Int
  size        String?
  color       String?
  unitPrice   Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Product {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  category    String
  brand       String
  price       Float
  compareAt   Float?
  rating      Float     @default(5.0)
  reviews     Int       @default(1)
  badge       String?
  colors      String    @db.Text
  sizes       String    @db.Text
  images      String    @db.LongText
  description String    @db.LongText
  fabric      String
  stock       Int       @default(10)
  salePrice   Float?
  saleEnd     String?
  status      String    @default("published")
  isActive    Boolean   @default(true)
  publishedAt DateTime? @default(now())
  sku         String?   @unique
  tags        String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("products")
}

model HomeSlider {
  id             String   @id @default(uuid())
  productId      String
  selectedImage  String?
  sliderOrder    Int      @default(0)
  tagline        String?
  title          String?
  description    String?  @db.Text
  ctaText        String?
  ratingText     String?
  objectPosition String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("home_sliders")
}

model VisitorSession {
  id              String         @id @default(uuid())
  sessionId       String         @unique
  userId          String?
  startedAt       DateTime       @default(now())
  lastActivityAt  DateTime       @default(now())
  endedAt         DateTime?
  durationSeconds Int?           @default(0)
  landingPage     String?
  exitPage        String?
  referrer        String?        @db.Text
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  trafficSource   String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  screenWidth     Int?
  screenHeight    Int?
  country         String?
  region          String?
  city            String?
  pagesViewed     Int            @default(0)
  productsViewed  Int            @default(0)
  eventsCount     Int            @default(0)
  hadCartActivity Boolean        @default(false)
  hadCheckout     Boolean        @default(false)
  hadPurchase     Boolean        @default(false)
  summarySent     Boolean        @default(false)
  summarySentAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  events          SessionEvent[]

  @@index([sessionId])
  @@index([startedAt])
  @@index([lastActivityAt])
  @@map("visitor_sessions")
}

model SessionEvent {
  id          String         @id @default(uuid())
  sessionId   String
  eventType   String
  page        String?
  path        String?
  productId   String?
  productName String?
  metadata    String?        @db.Text
  timestamp   DateTime       @default(now())
  createdAt   DateTime       @default(now())
  session     VisitorSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
  @@map("session_events")
}


